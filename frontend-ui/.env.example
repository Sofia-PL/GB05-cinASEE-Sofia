# Dirección del API Gateway (Componente 5). Todas las llamadas al backend pasan por él.
# Copia este fichero como ".env" si tu gateway no está en http://localhost:8080.
VITE_API_URL=http://localhost:8080

# Cine (id de src/assets/cines.json) donde se venden las sesiones reales de la Cartelera.
# El Componente 1 no tiene cines, así que su programación se asigna a uno solo.
VITE_CINE_CARTELERA=1
