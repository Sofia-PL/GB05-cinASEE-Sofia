{
  "mappings": [
    {
      "name": "Pasarela - cobro rechazado si el token contiene 'declined' (Reservas responde 402)",
      "priority": 1,
      "request": {
        "method": "POST", "url": "/redsys/charge",
        "bodyPatterns": [ { "matchesJsonPath": "$[?(@.paymentToken =~ /.*declined.*/)]" } ]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "status": "DECLINED", "reason": "Tarjeta denegada (WireMock)" }
      }
    },
    {
      "name": "Pasarela - cobro aprobado",
      "priority": 5,
      "request": { "method": "POST", "url": "/redsys/charge" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "status": "APPROVED", "transactionId": "WM-{{randomValue length=12 type='ALPHANUMERIC'}}" },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "Pasarela - devolución aprobada",
      "request": { "method": "POST", "url": "/redsys/refund" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "status": "APPROVED", "transactionId": "WM-REF-1" }
      }
    }
  ]
}
